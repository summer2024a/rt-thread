/*
 * hp232x_bootwrapper.S - HP232X specific bootwrapper implementation
 *
 * This file implements bootwrapper-style initialization for HP232X BSP,
 * including EL3 setup, GICv3 configuration, and EL transition.
 *
 * It is included by entry_point.S when BSP_USING_HP232X is defined.
 *
 * Copyright (c) 2025 lynxi
 * SPDX-License-Identifier: Apache-2.0
 */

#ifdef BSP_USING_HP232X

#ifndef _HP232X_BOOTWRAPPER_S_
#define _HP232X_BOOTWRAPPER_S_

#include "common.S"

    .text

/* ===== HP232X Bootwrapper Entry Point ===== */

.global hp232x_bootwrapper_init
hp232x_bootwrapper_init:
    /* HP232X: Check CurrentEL first to determine boot flow */

    mrs     x0, CurrentEL           /* CurrentEL Register. bit 2, 3. Others reserved */
    lsr     x0, x0, #2              /* Extract EL level: 0=EL0, 1=EL1, 2=EL2, 3=EL3 */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print CurrentEL value via UART directly */
    ldr     x1, =0x10006000         /* UART0 base address */
    ldr     x2, =0x10006014         /* UART0 LSR address */

    /* Print 'E' marker */
1:  ldr     w3, [x2]                /* Read LSR */
    tst     w3, #0x20               /* Check THRE bit */
    b.eq    1b                      /* Wait if not empty */
    mov     w3, #'E'
    str     w3, [x1]                /* Write THR */

    /* Print EL number */
2:  ldr     w3, [x2]                /* Read LSR */
    tst     w3, #0x20               /* Check THRE bit */
    b.eq    2b                      /* Wait if not empty */
    add     w3, w0, #'0'
    str     w3, [x1]                /* Write THR */
#endif

    cmp     x0, #3                  /* Check if we're at EL3 */
    b.eq    .hp232x_el3_boot        /* If EL3: full bootwrapper-style init */
    b.lt    .hp232x_el1_boot        /* If <EL3 (EL1/EL2): skip EL3 config, direct boot */

/* ===== EL3 Initialization (Bootwrapper-style) ===== */

.hp232x_el3_boot:
    /* At EL3: Perform bootwrapper-style initialization */

    /* Check if primary CPU */
    mrs     x0, mpidr_el1
    ldr     x1, =0xff00ffffff      /* MPIDR_ID_BITS */
    tst     x0, x1
    b.ne    .hp232x_secondary_cpu_init  /* secondary cores jump to per-CPU init */

    /* ===== Primary CPU only: Full EL3 setup ===== */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* Initialize UART debug registers */
    ldr     x6, =0x10006014         /* UART0 LSR */
    ldr     x7, =0x10006000         /* UART0 THR */
#endif

    /* Step 1: Initialize Interconnect (CCI500) - MUST be before GIC init! */
    /* Reference: lynxi-bootwrapper/interconnect.S:44-49 and boot.S:109 */
    ldr     x0, =0x9010000         /* CCI500 snoop control register base */
    mov     x1, #7                 /* Number of interfaces */

    /* CCI init loop: enable supported features on each interface */
cci_init_loop:
    cmp     x1, #0
    b.eq    cci_init_done          /* Done if all interfaces initialized */
    ldr     w3, [x0]               /* Read current snoop control register */
    lsr     w4, w3, #30            /* Extract supported features (bits 31:30) */
    orr     w3, w3, w4             /* Enable supported features */
    str     w3, [x0]               /* Write back */
    mov     x5, #0x1000            /* Offset for next interface */
    add     x0, x0, x5             /* Next interface */
    sub     x1, x1, #1             /* Decrement counter */
    b       cci_init_loop          /* Continue loop */

cci_init_done:
    /* Step 2: Set CPUECTLR.SMPEn (required for A53!) */
    /* Reference: lynxi-bootwrapper/boot.S:103-106 */
    mrs     x0, S3_1_c15_c2_1      /* Read CPUECTLR */
    orr     x0, x0, #0x40          /* Set SMPEn bit */
    msr     S3_1_c15_c2_1, x0      /* Write CPUECTLR */
    isb

    /* Step 3: Set SCR_EL3 (boot.S:49-53) */
#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'S' before SCR_EL3 */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    scr_debug
    mov     w8, #'S'                /* Print 'S' marker */
    str     w8, [x7]
scr_debug:
#endif

    mov     x0, #0x30               /* RES1 bits */
    orr     x0, x0, #(1 << 0)       /* NS=1: Non-secure EL1 */
    orr     x0, x0, #(1 << 8)       /* HVC enable */
    orr     x0, x0, #(1 << 10)      /* RW=1: 64-bit EL2 */
    msr     scr_el3, x0
    isb

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'C' after SCR_EL3 */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    scr_done_debug
    mov     w8, #'C'                /* Print 'C' marker */
    str     w8, [x7]
scr_done_debug:
#endif

#ifdef BSP_USING_GICV3
    /* Step 4: GICv3 Configuration (Bootwrapper + u-boot SPL) */

    /* Step 4.1: Enable GICv3 system register interface at EL3 */
    /* Reference: lynxi-bootwrapper/gic.S:196-200 */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'G' before GICv3 init */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    gic_sre_debug
    mov     w8, #'G'                /* Print 'G' marker */
    str     w8, [x7]
gic_sre_debug:
#endif

    mov     x0, #((1 << 3) | (1 << 0))  /* Enable=1 | SRE=1 */
    mrs     x1, S3_6_C12_C12_5          /* ICC_SRE_EL3 */
    orr     x1, x1, x0
    msr     S3_6_C12_C12_5, x1         /* Enable ICC_SRE_EL3 */
    isb

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'I' after ICC_SRE_EL3 */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    gic_sre_done_debug
    mov     w8, #'I'                /* Print 'I' marker */
    str     w8, [x7]
gic_sre_done_debug:
#endif

    /* Step 4.2: Configure GICv3 Distributor at EL3 */
    /* Reference: lynxi-bootwrapper/gic.S:107-109 + u-boot SPL gic_64.S:29-31 */
    ldr     x1, =0x08000000             /* GIC500 Distributor base */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'D' before GICD_CTLR config */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    gicd_debug
    mov     w8, #'D'                /* Print 'D' marker */
    str     w8, [x7]
gicd_debug:
#endif

    /* Enable all groups and affinity routing */
    mov     w0, #7                      /* EnableGrp0 | EnableGrp1NS | EnableGrp1S */
    orr     w0, w0, #(3 << 4)           /* ARE_S | ARE_NS (both bits 4 and 5) */
    str     w0, [x1]                    /* GICD_CTLR = 0x37 */
    dsb     sy
    isb

    /* Wait for GICD_CTLR_RWP to clear */
gicd_wait_rwp:
    ldr     w0, [x1]                    /* Read GICD_CTLR */
    tst     w0, #(1 << 31)              /* Test RWP bit (bit 31) */
    b.ne    gicd_wait_rwp               /* Wait until RWP clears */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'A' after GICD_CTLR config */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    gicd_done_debug
    mov     w8, #'A'                /* Print 'A' marker */
    str     w8, [x7]
gicd_done_debug:
#endif

    /* Step 4.3: Configure Redistributor (Primary CPU) */
    /* Reference: lynxi-bootwrapper/gic.S:143-171 */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'R' before loading Redistributor base */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    redist_debug
    mov     w8, #'R'                /* Print 'R' marker */
    str     w8, [x7]
redist_debug:
#endif

    ldr     x2, =0x08100000             /* GIC500 Redistributor base */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'B' after loading x2 base address */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    redist_base_debug
    mov     w8, #'B'                /* Print 'B' marker */
    str     w8, [x7]
redist_base_debug:
#endif

    mvn     w5, wzr                     /* w5 = 0xffffffff */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'M' after mvn w5, wzr */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    mvn_debug
    mov     w8, #'M'                /* Print 'M' marker */
    str     w8, [x7]
mvn_debug:
#endif

    /* Wakeup Redistributor: Clear ProcessorSleep, wait ChildrenAsleep */
    /* CRITICAL: Use w9 instead of w6 to avoid destroying x6 UART address! */
    mov     w9, #2                    /* First set w9 = 2 */
    mvn     w9, w9                    /* Then NOT: w9 = 0xFFFFFFFD (clear ProcessorSleep) */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print '2' after mvn */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    mvn2_debug
    mov     w8, #'2'                /* Print '2' marker */
    str     w8, [x7]
mvn2_debug:
#endif

    ldr     w4, [x2, #0x014]            /* GICR_WAKER */
    and     w4, w4, w9                  /* Clear ProcessorSleep bit (use w9!) */
    str     w4, [x2, #0x014]            /* Write back to GICR_WAKER */
    dsb     sy
    isb

    /* Wait for ChildrenAsleep to clear */
redist_wait_waker:
    ldr     w4, [x2, #0x014]            /* GICR_WAKER */
    ands    wzr, w4, #(1 << 2)          /* Test ChildrenAsleep bit */
    b.ne    redist_wait_waker           /* Wait until cleared */

    /* Configure GICR after wakeup */
    add     x3, x2, #(1 << 16)          /* SGI_base offset (0x10000) */

    str     w5, [x3, #0x80]             /* GICR_IGROUP0 = 0xffffffff (all Group1) */
    str     wzr, [x3, #0xD00]           /* GICR_IGRPMOD0 = 0 (Non-secure) */
    dsb     sy
    isb

    /* Enable SGI 0 for multi-core IPI communication */
    /* Reference: u-boot SPL gic_64.S:107-108 */
    mov     w11, #0x1                   /* Enable SGI 0 */
    str     w11, [x3, #0x100]           /* GICR_ISENABLER0 */
    dsb     sy

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'I' after SGI enable */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    sgi_debug
    mov     w8, #'I'                /* Print 'I' marker - SGI enabled */
    str     w8, [x7]
sgi_debug:
#endif

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'N' after GICR config */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    gicr_done_debug
    mov     w8, #'N'                /* Print 'N' marker */
    str     w8, [x7]
gicr_done_debug:
#endif

    /* Step 4.4: Set SPI interrupts to Group1 (after Redistributor) */
    /* Reference: lynxi-bootwrapper/gic.S:173-183 + u-boot SPL gic_64.S:35-41 */
    ldr     w2, [x1, #4]                /* GICD_TYPER */
    and     w2, w2, #0x1f               /* ITLinesNumber */
    cbz     w2, spi_config_done         /* Skip if no SPI interrupts */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'S' before SPI config */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    spi_debug
    mov     w8, #'S'                /* Print 'S' marker */
    str     w8, [x7]
spi_debug:
#endif

    add     x3, x1, #0x84               /* GICD_IGROUP1 (SPI group register) */
    add     x4, x1, #0xD04              /* GICD_IGRPMOD1 (SPI mode register) */

spi_group_loop:
    str     w5, [x3], #4                /* Set Group1 for 32 SPIs */
    str     wzr, [x4], #4               /* Set Non-secure mode */
    sub     w2, w2, #1
    cbnz    w2, spi_group_loop

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'P' after SPI config */
    ldr     w8, [x6]                /* Read LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    spi_done_debug
    mov     w8, #'P'                /* Print 'P' marker */
    str     w8, [x7]
spi_done_debug:
#endif

spi_config_done:
    /* Step 4.5: ICC System Registers Configuration (u-boot SPL style) */
    /* Purpose: Enable Group1 interrupts, allow EL1 access to ICC, set NS priority mask */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'E' before ICC enable setup */
    ldr     w8, [x6]                /* Read UART LSR */
    tst     w8, #0x20               /* Check THRE */
    b.eq    icc_debug
    mov     w8, #'E'                /* Print 'E' marker - ICC enable start */
    str     w8, [x7]
icc_debug:
#endif

    /* ICC_IGRPEN1_EL3: Enable Secure and Non-secure Group 1 interrupts */
    mov     x10, #0x3               /* EnableGrp1NS=1 | EnableGrp1S=1 */
    msr     S3_6_C12_C12_7, x10     /* ICC_IGRPEN1_EL3 */
    isb

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print '1' after ICC_IGRPEN1_EL3 */
    ldr     w8, [x6]
    tst     w8, #0x20
    b.eq    icc_igprpen1_debug
    mov     w8, #'1'
    str     w8, [x7]
icc_igprpen1_debug:
#endif

    /* ICC_SRE_EL2: Allow EL1 access to ICC system registers */
    mrs     x10, S3_4_C12_C9_5      /* Read ICC_SRE_EL2 */
    orr     x10, x10, #0xf          /* SRE=1 | Disable IRQ/FIQ bypass | Allow EL1 access */
    msr     S3_4_C12_C9_5, x10      /* ICC_SRE_EL2 */
    isb

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print '2' after ICC_SRE_EL2 */
    ldr     w8, [x6]
    tst     w8, #0x20
    b.eq    icc_sre_el2_debug
    mov     w8, #'2'
    str     w8, [x7]
icc_sre_el2_debug:
#endif

    /* ICC_PMR_EL1: Allow Non-secure access to priority mask (CRITICAL!) */
    mov     x10, #0x80              /* Non-Secure access to ICC_PMR_EL1 (bit 7) */
    msr     S3_0_C4_C6_0, x10       /* ICC_PMR_EL1 */
    isb

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'M' after ICC_PMR_EL1 */
    ldr     w8, [x6]
    tst     w8, #0x20
    b.eq    icc_pmr_debug
    mov     w8, #'M'                /* Print 'M' marker - PMR set */
    str     w8, [x7]
icc_pmr_debug:
#endif

    /* ICC_CTLR_EL1: Non-secure CPU interface configuration */
    msr     S3_0_C12_C12_4, xzr      /* ICC_CTLR_EL1 = 0 */
    isb

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'C' after ICC_CTLR_EL1 */
    ldr     w8, [x6]
    tst     w8, #0x20
    b.eq    icc_ctlr_el1_debug
    mov     w8, #'C'
    str     w8, [x7]
icc_ctlr_el1_debug:
#endif

#endif /* BSP_USING_GICV3 */

    /* Step 5: Disable copro. traps to EL3 (boot.S:55) */
    msr     cptr_el3, xzr

    /* Step 6: Set timer frequency (boot.S:75-77) */
    ldr     x0, =31250000           /* cnt_freq value */
    msr     cntfrq_el0, x0

    /* Step 7: Set SCTLR_EL2 (spin.S:22-23) */
    ldr     x0, =(3 << 28 | 3 << 22 | 1 << 18 | 1 << 16 | 1 << 11 | 3 << 4)  /* SCTLR_EL2_RESET */
    msr     sctlr_el2, x0

    /* Step 8: Set SPSR_EL3 and ELR_EL3 for eret (spin.S:24-26) */
    adr     x0, .hp232x_after_eret   /* Return address after eret */
    mov     x1, #(9 | (1 << 6) | (1 << 7) | (1 << 8) | (1 << 9))  /* SPSR_KERNEL: EL2h + all exceptions masked */
    msr     elr_el3, x0
    msr     spsr_el3, x1

    /* Step 9: Execute eret */
    eret

.hp232x_after_eret:
    /* At EL2 now: Continue to EL1 */
    b       .hp232x_el1_continue

/* ===== Secondary CPU Initialization (Per-CPU) ===== */

.hp232x_secondary_cpu_init:
    /* Secondary CPU in EL3: perform per-CPU GIC init and EL transition */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* Initialize UART debug registers for secondary CPUs */
    ldr     x6, =0x10006014         /* UART0 LSR */
    ldr     x7, =0x10006000         /* UART0 THR */

    /* DEBUG: Print 'W' marker for secondary CPU */
    ldr     w8, [x6]
    tst     w8, #0x20
    b.eq    sec_debug_w
    mov     w8, #'W'                /* Print 'W' - Secondary CPU wake */
    str     w8, [x7]
sec_debug_w:
#endif

    /* Step 1: Per-CPU GIC Redistributor Configuration */
    /* Calculate current CPU's Redistributor base address */

    /* Get current CPU affinity */
    mrs     x10, mpidr_el1
    and     x11, x10, #0xFF            /* Aff0 [7:0] */
    ubfx    x12, x10, #8, #8           /* Aff1 [15:8] */

    /* Calculate linear CPU ID: LinearID = Aff1 * 4 + Aff0 */
    lsl     x12, x12, #2               /* Aff1 * 4 */
    add     x11, x11, x12              /* Linear ID */
    sub     x11, x11, #1               /* Secondary CPUs: index starts from 1 */

    /* Calculate Redistributor base for this CPU */
    ldr     x2, =0x08100000            /* Redistributor base */
    mov     x13, #(2 << 16)            /* Each Redistributor = 128KB */
    mul     x14, x11, x13              /* Offset = LinearID * 128KB */
    add     x2, x2, x14                /* Current CPU Redistributor base */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'R' for Redistributor */
    ldr     w8, [x6]
    tst     w8, #0x20
    b.eq    sec_debug_r
    mov     w8, #'R'
    str     w8, [x7]
sec_debug_r:
#endif

    /* Wakeup Redistributor: Clear ProcessorSleep */
    mov     w9, #2
    mvn     w9, w9                     /* w9 = 0xFFFFFFFD */
    ldr     w4, [x2, #0x014]           /* GICR_WAKER */
    and     w4, w4, w9                 /* Clear ProcessorSleep bit */
    str     w4, [x2, #0x014]
    dsb     sy
    isb

    /* Wait for ChildrenAsleep to clear */
sec_wait_waker:
    ldr     w4, [x2, #0x014]
    ands    wzr, w4, #(1 << 2)
    b.ne    sec_wait_waker

    /* Configure SGI/PPI interrupt groups */
    add     x3, x2, #(1 << 16)         /* SGI_base */
    mvn     w5, wzr                    /* w5 = 0xFFFFFFFF */
    str     w5, [x3, #0x80]            /* GICR_IGROUP0 = 0xFFFFFFFF */
    str     wzr, [x3, #0xD00]          /* GICR_IGRPMOD0 = 0x00000000 */

    /* Enable SGI 0 for IPI */
    mov     w11, #0x1
    str     w11, [x3, #0x100]          /* GICR_ISENABLER0 */
    dsb     sy

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'G' for GICR done */
    ldr     w8, [x6]
    tst     w8, #0x20
    b.eq    sec_debug_g
    mov     w8, #'G'
    str     w8, [x7]
sec_debug_g:
#endif

#ifdef BSP_USING_GICV3
    /* Step 2: ICC System Registers Configuration */
    /* Same as primary CPU: enable Group1, allow EL1 access */

    /* ICC_IGRPEN1_EL3: Enable Group 1 interrupts */
    mov     x10, #0x3
    msr     S3_6_C12_C12_7, x10         /* ICC_IGRPEN1_EL3 */
    isb

    /* ICC_SRE_EL2: Allow EL1 access */
    mrs     x10, S3_4_C12_C9_5
    orr     x10, x10, #0xf
    msr     S3_4_C12_C9_5, x10
    isb

    /* ICC_PMR_EL1: Allow NS priority access */
    mov     x10, #0x80
    msr     S3_0_C4_C6_0, x10           /* ICC_PMR_EL1 */
    isb

    /* ICC_CTLR_EL1: Non-secure CPU interface */
    msr     S3_0_C12_C12_4, xzr
    isb

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'C' for ICC config done */
    ldr     w8, [x6]
    tst     w8, #0x20
    b.eq    sec_debug_c
    mov     w8, #'C'
    str     w8, [x7]
sec_debug_c:
#endif
#endif

    /* Step 3: EL Transition (EL3 → EL2 → EL1) */
    /* Same as primary CPU: need to transition to EL1 before spin wait */

    /* Set SCR_EL3 for EL transition */
    mov     x0, #0x30               /* RES1 bits */
    orr     x0, x0, #(1 << 0)       /* NS=1 */
    orr     x0, x0, #(1 << 8)       /* HVC enable */
    orr     x0, x0, #(1 << 10)      /* RW=1: 64-bit EL2 */
    msr     scr_el3, x0
    isb

    /* Set SCTLR_EL2 */
    ldr     x0, =(3 << 28 | 3 << 22 | 1 << 18 | 1 << 16 | 1 << 11 | 3 << 4)
    msr     sctlr_el2, x0
    isb

    /* Set SPSR_EL3 and ELR_EL3 for EL3→EL2 */
    adr     x0, .hp232x_secondary_el2
    mov     x1, #(9 | (1 << 6) | (1 << 7) | (1 << 8) | (1 << 9))
    msr     elr_el3, x0
    msr     spsr_el3, x1
    isb

    /* EL3→EL2 transition */
    eret

.hp232x_secondary_el2:
    /* At EL2: Continue EL2→EL1 transition */

    /* Set HCR_EL2 */
    mov     x0, #(1 << 31)          /* RW=1: 64-bit EL1 */
    msr     hcr_el2, x0
    isb

    /* Set SCTLR_EL1 */
    mov     x0, #0
    msr     sctlr_el1, x0
    isb

    /* Set SPSR_EL2 and ELR_EL2 for EL2→EL1 */
    adr     x0, .hp232x_secondary_el1
    mov     x1, #(5 | (1 << 6) | (1 << 7) | (1 << 8) | (1 << 9))
    msr     elr_el2, x0
    msr     spsr_el2, x1
    isb

    /* EL2→EL1 transition */
    eret

.hp232x_secondary_el1:
    /* At EL1: Enter spin wait loop */

#ifdef BSP_USING_HP232X_DEBUG_UART
    /* DEBUG: Print 'S' for spin */
    ldr     w8, [x6]
    tst     w8, #0x20
    b.eq    sec_debug_s
    mov     w8, #'S'
    str     w8, [x7]
sec_debug_s:
#endif

    /* Jump to secondary spin wait */
    b       .hp232x_secondary_spin

/* ===== EL1 Entry Points ===== */

.hp232x_el1_boot:
    /* Already at EL1: Skip EL3 initialization, direct boot */
    b       .hp232x_el1_continue

.hp232x_el1_continue:
    /* At EL1: Continue normal boot flow */
    /* Return to entry_point.S for standard RT-Thread initialization */

/* ===== Secondary CPU Spin Wait ===== */

.hp232x_secondary_spin:
    /* Secondary CPU: spin wait for mailbox release (bootwrapper spin.S:46-59) */
    /* Calculate per-CPU mbox entry */
    mrs     x5, mpidr_el1
    and     x6, x5, #0xFF            /* Aff0 [7:0] */
    ubfx    x7, x5, #8, #8           /* Aff1 [15:8] */
    lsl     x7, x7, #2               /* Aff1 * 4 (cluster size) */
    add     x5, x6, x7               /* Linear ID = Aff1*4 + Aff0 */
    sub     x5, x5, #1               /* Secondary CPUs index 0-6 */
    lsl     x5, x5, #3               /* * 8 bytes per entry */

    /* Spin table base in IRAM0 (constraint-compliant) */
    ldr     x4, =0x0401FF00         /* mbox_address = IRAM0 spin table */
    add     x4, x4, x5              /* Current CPU's mbox entry */

spin_wait_loop:
    wfe
    ldr     x1, [x4]                /* Read entry point */
    cbz     x1, spin_wait_loop      /* Zero means not released */
    br      x1                       /* Jump to entry point when released */

/* ===== HP232X Data Sections ===== */

    .section .early_hp232x, "aw", @progbits

/* HP232X temporary stack in IRAM0 (first 256KB, constraint-compliant) */
    .align 12
.hp232x_temp_stack:
    .space 4096               /* 4KB temp stack in IRAM0 */
.hp232x_temp_stack_top:

/* HP232X secondary CPU spin table - placed in IRAM0 first 256KB (constraint-compliant) */
    .align 12
.hp232x_spin_table:
    .space 64                   /* Spin table for up to 8 CPUs */
.hp232x_spin_table_end:

/* HP232X stack area - placed in IRAM1 last 256KB (constraint-compliant) */
    .align 4
.hp232x_stack_bottom:
    .space 256                  /* 256 bytes per CPU (bootwrapper STACK_SIZE) */
.hp232x_stack_top:

#endif /* _HP232X_BOOTWRAPPER_S_ */

#endif /* BSP_USING_HP232X */