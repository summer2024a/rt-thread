config BSP_SUPPORT_FPU
    bool "Using Float"
    default n

menu "Hardware Drivers Config"
    menu "BCM Peripheral Drivers"
        menuconfig BSP_USING_UART
            bool "Using UART"
            select RT_USING_SERIAL
            default y

            if BSP_USING_UART
                config RT_USING_UART0
                bool "Enable UART 0"
                default y

                config RT_USING_UART1
                bool "Enable UART 1"
                default n
            endif

        menuconfig BSP_USING_GIC
            bool "Enable GIC"
            select RT_USING_GIC
            default y

            if BSP_USING_GIC
                choice
                    prompt "GIC Version"
                    default BSP_USING_GICV3

                    config BSP_USING_GICV2
                        bool "Enable GIC400(GICV2)"

                    config BSP_USING_GICV3
                        bool "Enable GIC500(GICV3)"
                endchoice

                config RT_BSP_GIC_DBG
                    bool "Enable GIC group config debug"
                    default n
                    help
                        Enable GIC interrupt group configuration debug code.
                        Useful for debugging GIC secure/non-secure routing.
                        Disable to reduce code size.
            endif

        config KERNEL_ASPACE_START
            hex "Kernel aspace start address"
            default 0x04000000

        config BSP_USING_PIN
            bool "Using PIN"
            select RT_USING_PIN
            default n

        config BSP_USING_CORETIMER
            bool "Using ARM generic core timer"
            select RT_USING_CORETIMER
            depends on !BSP_USING_APB_TIMER_AS_TICK
            default y

        menuconfig BSP_USING_APB_TIMER
            bool "Enable DesignWare APB system timer"
            default y

        if BSP_USING_APB_TIMER
            config BSP_USING_APB_TIMER_AS_TICK
                bool "Use DesignWare APB timer as system tick"
                default y
                help
                    Use DW APB timer@0x10012000 as the RT-Thread OS tick source.
                    When enabled, the ARM generic timer is not initialized as the
                    system tick source.

            config HP232X_APB_TIMER_CLOCK
                int "DesignWare APB timer clock frequency"
                default 50000000

            config HP232X_APB_TIMER_TICK_ID
                int "DesignWare APB timer channel for system tick"
                range 0 3
                default 0
        endif

        config RT_BSP_PMON_TEST
            bool "Enable PMON GIC monitor thread"
            default y
            help
                Enable the PMON (Periodic MONitor) thread that prints GIC
                status and system tick information every 2.5 seconds.
                Useful for verifying system tick and interrupt functionality.
                Disable to reduce code size and IRAM usage.

        config BSP_USING_HP232X_PMON_BIND_CPU1
            bool "Run PMON thread bound to CPU1 (SMP test)"
            depends on RT_BSP_PMON_TEST && RT_USING_SMP
            default n
            help
                Bind the PMON monitor thread to CPU1 and print rt_hw_cpu_id()
                on each sample. Verifies IPI-driven scheduling on the secondary
                core while system tick stays on CPU0 APB timer.

        config BSP_USING_HP232X_SMP_BIND_TEST
            bool "Enable SMP CPU1 bind self-test at boot"
            depends on RT_USING_SMP
            default n
            help
                Create a worker thread bound to CPU1 during main() and verify
                that it runs. For bring-up/debug only; disable in release builds.
    endmenu
endmenu
