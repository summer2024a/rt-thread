/*
 * HP232X Timer中断阻塞诊断程序
 *
 * 目的：检查所有可能阻塞timer中断的软件配置
 *
 * 检查项：
 * 1. DAIF状态（CPU中断屏蔽）
 * 2. VBAR_EL1（异常向量表）
 * 3. ICC系统寄存器（GIC CPU接口）
 * 4. GIC寄存器（中断启用状态）
 * 5. Timer硬件状态
 * 6. ISR安装状态
 * 7. 中断处理函数调用链
 *
 * Copyright (c) 2025 lynxi
 */

#include <rtthread.h>
#include <rthw.h>
#include "lynxi.h"

/* 计数器用于验证中断是否触发 */
volatile rt_uint32_t timer_isr_counter = 0;
volatile rt_uint32_t timer_vector_entry_counter = 0;

/* Timer ISR钩子函数 */
static void timer_isr_hook(int vector, void *parameter)
{
    timer_isr_counter++;
    if (timer_isr_counter == 1) {
        rt_kprintf("\n★★★ TIMER ISR CALLED! Counter=%d ★★★\n", timer_isr_counter);
    } else if (timer_isr_counter <= 5) {
        rt_kprintf("[TIMER_ISR] Counter=%d\n", timer_isr_counter);
    }
}

/* 诊断函数：检查所有软件配置 */
void diagnose_timer_interrupt_blocking(void)
{
    rt_kprintf("\n");
    rt_kprintf("============================================================\n");
    rt_kprintf("       HP232X Timer Interrupt Blocking Diagnosis\n");
    rt_kprintf("============================================================\n");

    /* ========== 1. CPU中断屏蔽状态 ========== */
    rt_kprintf("\n[1] CPU Interrupt Mask State (DAIF)\n");
    rt_kprintf("----------------------------------------\n");

    rt_uint64_t daif = 0;
    asm volatile("mrs %0, DAIF" : "=r"(daif));

    rt_kprintf("DAIF register: 0x%02llx\n", daif);
    rt_kprintf("  D (Debug mask):  %d\n", (daif >> 9) & 1);
    rt_kprintf("  A (SError mask): %d\n", (daif >> 8) & 1);
    rt_kprintf("  I (IRQ mask):    %d ← CRITICAL!\n", (daif >> 7) & 1);
    rt_kprintf("  F (FIQ mask):    %d\n", (daif >> 6) & 1);

    if ((daif >> 7) & 1) {
        rt_kprintf("\n⚠⚠⚠ PROBLEM: IRQ interrupts MASKED! (I=1)\n");
        rt_kprintf("Timer cannot trigger with IRQ masked!\n");
        rt_kprintf("Fix: asm volatile(\"msr DAIFclr, #0x2\" ::: \"memory\");\n");
    } else {
        rt_kprintf("✓ IRQ interrupts UNMASKED (I=0) - OK\n");
    }

    /* ========== 2. 异常向量表 ========== */
    rt_kprintf("\n[2] Exception Vector Table (VBAR_EL1)\n");
    rt_kprintf("----------------------------------------\n");

    rt_uint64_t vbar_el1 = 0;
    asm volatile("mrs %0, VBAR_EL1" : "=r"(vbar_el1));
    rt_kprintf("VBAR_EL1: 0x%llx\n", vbar_el1);

    if (vbar_el1 == 0) {
        rt_kprintf("\n⚠⚠⚠ PROBLEM: Vector table NOT configured!\n");
        rt_kprintf("Timer interrupt has no handler!\n");
    } else {
        rt_kprintf("✓ Vector table configured at 0x%llx\n", vbar_el1);

        /* 检查vector_irq入口 */
        rt_uint64_t vector_irq_addr = vbar_el1 + 0x80;  /* IRQ offset */
        rt_kprintf("  vector_irq address: 0x%llx (offset +0x80)\n", vector_irq_addr);

        /* 尝试读取vector_irq的前几个字节 */
        volatile rt_uint32_t *vector_irq_ptr = (volatile rt_uint32_t *)vector_irq_addr;
        rt_kprintf("  vector_irq[0]: 0x%08x\n", vector_irq_ptr[0]);

        /* 检查是否是死循环（wfe + b） */
        if ((vector_irq_ptr[0] & 0xFC000000) == 0x14000000) {  /* b指令 */
            rt_kprintf("\n⚠⚠⚠ PROBLEM: vector_irq is a branch (possible infinite loop)!\n");
            rt_kprintf("This explains why timer doesn't trigger!\n");
        } else if (vector_irq_ptr[0] != 0) {
            rt_kprintf("✓ vector_irq has valid code\n");
        }
    }

    /* ========== 3. ICC系统寄存器 ========== */
    rt_kprintf("\n[3] GIC CPU Interface (ICC System Registers)\n");
    rt_kprintf("----------------------------------------\n");

    rt_uint64_t icc_igrpen1_el1 = 0;
    asm volatile("mrs %0, S3_0_C12_C12_7" : "=r"(icc_igrpen1_el1));
    rt_kprintf("ICC_IGRPEN1_EL1: 0x%llx (Group1 interrupt enable)\n", icc_igrpen1_el1);

    if ((icc_igrpen1_el1 & 1) == 0) {
        rt_kprintf("\n⚠⚠⚠ PROBLEM: Group1 interrupts DISABLED!\n");
        rt_kprintf("Timer (Group1 NS) cannot trigger!\n");
    } else {
        rt_kprintf("✓ Group1 interrupts ENABLED\n");
    }

    rt_uint64_t icc_pmr_el1 = 0;
    asm volatile("mrs %0, S3_0_C4_C6_0" : "=r"(icc_pmr_el1));
    rt_kprintf("ICC_PMR_EL1: 0x%llx (Priority mask)\n", icc_pmr_el1);

    rt_uint64_t icc_ctlr_el1 = 0;
    asm volatile("mrs %0, S3_0_C12_C12_4" : "=r"(icc_ctlr_el1));
    rt_kprintf("ICC_CTLR_EL1: 0x%llx (CPU interface control)\n", icc_ctlr_el1);

    /* ========== 4. GIC Distributor配置 ========== */
    rt_kprintf("\n[4] GIC Distributor Configuration\n");
    rt_kprintf("----------------------------------------\n");

    volatile rt_uint32_t *gicd_ctlr = (volatile rt_uint32_t *)(platform_get_gic_dist_base());
    rt_uint32_t gicd_ctlr_val = *gicd_ctlr;
    rt_kprintf("GICD_CTLR: 0x%08x\n", gicd_ctlr_val);
    rt_kprintf("  EnableGrp0:    %d\n", (gicd_ctlr_val >> 0) & 1);
    rt_kprintf("  EnableGrp1NS:  %d ← CRITICAL for timer!\n", (gicd_ctlr_val >> 1) & 1);
    rt_kprintf("  EnableGrp1S:   %d\n", (gicd_ctlr_val >> 2) & 1);
    rt_kprintf("  ARE_NS:        %d\n", (gicd_ctlr_val >> 5) & 1);
    rt_kprintf("  DS:            %d\n", (gicd_ctlr_val >> 6) & 1);

    if ((gicd_ctlr_val & 2) == 0) {
        rt_kprintf("\n⚠⚠⚠ PROBLEM: Group1 NS interrupts DISABLED!\n");
        rt_kprintf("Timer (Group1 NS) cannot trigger!\n");
    } else {
        rt_kprintf("✓ Group1 NS interrupts ENABLED\n");
    }

    /* ========== 5. Timer中断在GIC的状态 ========== */
    rt_kprintf("\n[5] Timer IRQ30 State in GIC\n");
    rt_kprintf("----------------------------------------\n");

    /* GICR_ISENABLER0 (Timer30在bit30) */
    volatile rt_uint32_t *gicr_isenabler0 = (volatile rt_uint32_t *)(0x08110000 + 0x100);
    rt_uint32_t timer_enabled = *gicr_isenabler0;
    rt_kprintf("GICR_ISENABLER0: 0x%08x\n", timer_enabled);
    rt_kprintf("  Timer30 enabled: %d ← CRITICAL!\n", (timer_enabled >> 30) & 1);

    if ((timer_enabled >> 30) & 1) {
        rt_kprintf("✓ Timer30 ENABLED in GICR_ISENABLER0\n");
    } else {
        rt_kprintf("\n⚠⚠⚠ PROBLEM: Timer30 NOT enabled in GIC!\n");
        rt_kprintf("Timer interrupt cannot reach CPU!\n");
    }

    /* Timer优先级 */
    volatile rt_uint32_t *gicr_ipriorityr = (volatile rt_uint32_t *)(0x08110000 + 0x410);
    rt_uint32_t timer_priority_word = *gicr_ipriorityr;
    rt_uint8_t timer_priority = (timer_priority_word >> 24) & 0xFF;
    rt_kprintf("Timer30 priority: 0x%02x (%d)\n", timer_priority, timer_priority);
    rt_kprintf("PMR threshold:    0x%02llx (%lld)\n", icc_pmr_el1, icc_pmr_el1);

    if (timer_priority >= icc_pmr_el1) {
        rt_kprintf("\n⚠⚠⚠ PROBLEM: Timer priority >= PMR, BLOCKED!\n");
        rt_kprintf("Timer needs priority < PMR to trigger!\n");
    } else {
        rt_kprintf("✓ Timer priority < PMR, can trigger\n");
    }

    /* Timer组别 */
    volatile rt_uint32_t *gicr_igroupr0 = (volatile rt_uint32_t *)(0x08110000 + 0x80);
    rt_uint32_t timer_group = *gicr_igroupr0;
    rt_kprintf("GICR_IGROUPR0: 0x%08x\n", timer_group);
    rt_kprintf("  Timer30 Group: %d (0=Group0, 1=Group1)\n", (timer_group >> 30) & 1);

    volatile rt_uint32_t *gicr_igrpmodr0 = (volatile rt_uint32_t *)(0x08110000 + 0xD00);
    rt_uint32_t timer_mod = *gicr_igrpmodr0;
    rt_kprintf("GICR_IGRPMODR0: 0x%08x\n", timer_mod);
    rt_kprintf("  Timer30 Mod:   %d (0=NS, 1=Secure)\n", (timer_mod >> 30) & 1);

    /* ========== 6. Timer硬件状态 ========== */
    rt_kprintf("\n[6] Timer Hardware State\n");
    rt_kprintf("----------------------------------------\n");

    rt_uint64_t cntp_ctl = 0;
    asm volatile("mrs %0, CNTP_CTL_EL0" : "=r"(cntp_ctl));
    rt_kprintf("CNTP_CTL_EL0: 0x%llx\n", cntp_ctl);
    rt_kprintf("  ENABLE:  %d ← Timer enabled?\n", (cntp_ctl >> 0) & 1);
    rt_kprintf("  IMASK:   %d ← Interrupt masked?\n", (cntp_ctl >> 1) & 1);
    rt_kprintf("  ISTATUS: %d ← Timer firing?\n", (cntp_ctl >> 2) & 1);

    if ((cntp_ctl & 1) == 0) {
        rt_kprintf("\n⚠⚠⚠ PROBLEM: Timer hardware DISABLED!\n");
    } else {
        rt_kprintf("✓ Timer hardware ENABLED\n");
    }

    if ((cntp_ctl >> 1) & 1) {
        rt_kprintf("\n⚠⚠⚠ PROBLEM: Timer interrupt MASKED in hardware!\n");
    } else {
        rt_kprintf("✓ Timer interrupt UNMASKED in hardware\n");
    }

    rt_uint64_t cntp_tval = 0;
    asm volatile("mrs %0, CNTP_TVAL_EL0" : "=r"(cntp_tval));
    rt_kprintf("CNTP_TVAL_EL0: 0x%llx (%lld ticks until next interrupt)\n", cntp_tval, cntp_tval);

    rt_uint64_t cntfrq = 0;
    asm volatile("mrs %0, CNTFRQ_EL0" : "=r"(cntfrq));
    rt_uint64_t time_ms = (cntp_tval * 1000) / cntfrq;
    rt_kprintf("  Time until next tick: %lld ms\n", time_ms);

    if (cntp_tval <= 0) {
        rt_kprintf("\n⚠ Timer firing NOW (TVAL <= 0)\n");
        rt_kprintf("If timer not triggering, check ISR handler!\n");
    }

    /* ========== 7. ISR安装检查 ========== */
    rt_kprintf("\n[7] ISR Installation Check\n");
    rt_kprintf("----------------------------------------\n");

    extern struct rt_irq_desc isr_table[];
    rt_kprintf("ISR table address: %p\n", isr_table);

    struct rt_irq_desc *timer_desc = &isr_table[30];
    rt_kprintf("Timer30 ISR entry:\n");
    rt_kprintf("  handler: %p\n", timer_desc->handler);
    rt_kprintf("  param:   %p\n", timer_desc->param);

    if (timer_desc->handler == RT_NULL) {
        rt_kprintf("\n⚠⚠⚠ PROBLEM: Timer ISR handler NOT installed!\n");
        rt_kprintf("Timer interrupt has no handler!\n");
    } else {
        rt_kprintf("✓ Timer ISR handler installed\n");
        rt_kprintf("  Handler function: %p\n", timer_desc->handler);
    }

    /* ========== 8. 中断处理函数调用链检查 ========== */
    rt_kprintf("\n[8] Interrupt Handler Call Chain\n");
    rt_kprintf("----------------------------------------\n");

    rt_kprintf("Expected call chain:\n");
    rt_kprintf("  1. Timer fires → IRQ exception\n");
    rt_kprintf("  2. CPU jumps to VBAR_EL1 + 0x80 (vector_irq)\n");
    rt_kprintf("  3. vector_irq saves context\n");
    rt_kprintf("  4. vector_irq calls rt_hw_trap_irq()\n");
    rt_kprintf("  5. rt_hw_trap_irq calls arm_gic_get_active_irq()\n");
    rt_kprintf("  6. arm_gic_get_active_irq reads ICC_IAR1_EL1 (IRQ ID=30)\n");
    rt_kprintf("  7. rt_hw_trap_irq calls isr_table[30].handler\n");
    rt_kprintf("  8. ISR handler calls rt_tick_increase()\n");
    rt_kprintf("  9. ISR handler calls arm_gic_ack(30)\n");
    rt_kprintf("  10. vector_irq restores context and eret\n");

    rt_kprintf("\nVerification counters:\n");
    extern volatile rt_uint32_t gtimer_isr_counter;
    rt_kprintf("  gtimer_isr_counter:        %d (ISR handler calls)\n", gtimer_isr_counter);
    rt_kprintf("  timer_isr_counter:        %d (ISR hook calls)\n", timer_isr_counter);

    if (timer_isr_counter == 0) {
        rt_kprintf("\n⚠ Timer ISR never called!\n");
        rt_kprintf("Possible causes:\n");
        rt_kprintf("  - vector_irq is dead loop (check BSP_USING_HP232X_SPIN_TABLE)\n");
        rt_kprintf("  - CPU interrupts masked (DAIF I=1)\n");
        rt_kprintf("  - GIC not configured properly\n");
        rt_kprintf("  - Timer hardware not enabled\n");
    }

    /* ========== 诊断总结 ========== */
    rt_kprintf("\n============================================================\n");
    rt_kprintf("                 DIAGNOSIS SUMMARY\n");
    rt_kprintf("============================================================\n");

    rt_kprintf("\nPotential blockers found:\n");
    int blockers = 0;

    if ((daif >> 7) & 1) {
        rt_kprintf("  ✗ IRQ masked in DAIF\n");
        blockers++;
    }
    if (vbar_el1 == 0) {
        rt_kprintf("  ✗ Vector table not configured\n");
        blockers++;
    }
    if ((icc_igrpen1_el1 & 1) == 0) {
        rt_kprintf("  ✗ Group1 interrupts disabled in ICC\n");
        blockers++;
    }
    if ((gicd_ctlr_val & 2) == 0) {
        rt_kprintf("  ✗ Group1 NS disabled in GICD\n");
        blockers++;
    }
    if ((timer_enabled >> 30) == 0) {
        rt_kprintf("  ✗ Timer30 not enabled in GICR\n");
        blockers++;
    }
    if (timer_priority >= icc_pmr_el1) {
        rt_kprintf("  ✗ Timer priority blocked by PMR\n");
        blockers++;
    }
    if ((cntp_ctl & 1) == 0) {
        rt_kprintf("  ✗ Timer hardware disabled\n");
        blockers++;
    }
    if ((cntp_ctl >> 1) & 1) {
        rt_kprintf("  ✗ Timer interrupt masked in hardware\n");
        blockers++;
    }
    if (timer_desc->handler == RT_NULL) {
        rt_kprintf("  ✗ Timer ISR not installed\n");
        blockers++;
    }

    if (blockers == 0) {
        rt_kprintf("  ✓ No obvious blockers found!\n");
        rt_kprintf("\nPossible hidden issues:\n");
        rt_kprintf("  - vector_irq implementation (check BSP_USING_HP232X_SPIN_TABLE)\n");
        rt_kprintf("  - Interrupt routing (GICD_IROUTER)\n");
        rt_kprintf("  - ICC_BPR1_EL1 (Binary point)\n");
        rt_kprintf("  - ICC_CTLR_EL1 (EOImode, CBPR)\n");
    } else {
        rt_kprintf("\nTotal blockers found: %d\n", blockers);
    }

    rt_kprintf("\n============================================================\n");
}

/* 初始化诊断线程 */
int timer_diagnosis_init(void)
{
    diagnose_timer_interrupt_blocking();

    /* 安装timer ISR钩子 */
    rt_hw_interrupt_install(30, timer_isr_hook, RT_NULL, "timer_diag");

    rt_kprintf("\nTimer ISR hook installed. Waiting for interrupt...\n");

    /* 等待5秒观察timer触发 */
    for (int i = 0; i < 5; i++) {
        rt_thread_mdelay(1000);
        rt_kprintf("[WAIT] %d seconds, timer_isr_counter=%d\n", i+1, timer_isr_counter);

        if (timer_isr_counter > 0) {
            rt_kprintf("\n★★★ SUCCESS: Timer interrupt triggered! ★★★\n");
            break;
        }
    }

    if (timer_isr_counter == 0) {
        rt_kprintf("\n✗ Timer interrupt NOT triggered after 5 seconds\n");
        rt_kprintf("Run detailed diagnosis again to find the blocker.\n");
    }

    return 0;
}
INIT_APP_EXPORT(timer_diagnosis_init);