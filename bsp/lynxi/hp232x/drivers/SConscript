from building import *

cwd     = GetCurrentDir()
src     = Glob('*.c') + Glob('*.cpp')

# pre_entry.S only needed for BL21 mode (EL3 bootwrapper initialization)
# BL22 mode: bootwrapper already done EL transition, skip pre_entry.S
if GetDepend('BSP_USING_HP232X_BL22') == False:
    src += Glob('*.S')

CPPPATH = [cwd, str(Dir('#'))]

group = DefineGroup('driver', src, depend = [''], CPPPATH = CPPPATH)

Return('group')
