/*
 * 最终诊断：检查Timer是否真正进入firing状态
 *
 * 核心问题：虽然所有配置正确，但Timer中断信号可能没有真正产生
 */

#include <rtthread.h>
#include <rthw.h>

void check_timer_firing_status(void)
{
    rt_kprintf("\n");
    rt_kprintf("========================================\n");
    rt_kprintf(" Timer Firing Status Check (Final)\n");
    rt_kprintf("========================================\n");

    /* 轮询10秒，检查Timer是否进入firing状态 */
    for (int i = 0; i < 100; i++) {
        rt_uint64_t cntp_ctl, cntp_tval, cntpct;

        asm volatile("mrs %0, CNTP_CTL_EL0" : "=r"(cntp_ctl));
        asm volatile("mrs %0, CNTP_TVAL_EL0" : "=r"(cntp_tval));
        asm volatile("mrs %0, CNTPCT_EL0" : "=r"(cntpct));

        rt_uint32_t enable = (cntp_ctl >> 0) & 1;
        rt_uint32_t imask = (cntp_ctl >> 1) & 1;
        rt_uint32_t istatus = (cntp_ctl >> 2) & 1;

        rt_kprintf("[%d] CTL=0x%llx EN=%d IM=%d ISTATUS=%d TVAL=%lld\n",
                   i, cntp_ctl, enable, imask, istatus, cntp_tval);

        /* ISTATUS=1表示Timer正在firing，应该触发中断 */
        if (istatus == 1) {
            rt_kprintf("\n★★★★★ TIMER IS FIRING! ISTATUS=1 ★★★★★\n");
            rt_kprintf("Timer should have sent interrupt signal to GIC!\n");

            /* 检查GIC是否收到信号 */
            volatile rt_uint32_t *gicr_ispendr0 = (rt_uint32_t *)(0x08110000 + 0x200);
            rt_uint32_t pending = *gicr_ispendr0;

            rt_kprintf("GICR_ISPENDR0: 0x%08x (Timer30 pending=%d)\n",
                       pending, (pending >> 30) & 1);

            if ((pending >> 30) & 1) {
                rt_kprintf("★★★★★★ GIC RECEIVED Timer interrupt! ★★★★★★\n");
                rt_kprintf("But CPU didn't trigger IRQ exception!\n");
                rt_kprintf("Possible: IRQ routed to EL3/EL2 instead of EL1!\n");
            } else {
                rt_kprintf("★★★★★★ GIC DID NOT receive interrupt! ★★★★★★\n");
                rt_kprintf("Problem: Timer not sending signal to GIC!\n");
                rt_kprintf("Check: Timer interrupt routing (IRQ routing register)\n");
            }

            break;
        }

        rt_thread_mdelay(100);
    }

    rt_kprintf("\n========================================\n");
    rt_kprintf("Check Complete\n");
    rt_kprintf("========================================\n");
}

int timer_firing_check_init(void)
{
    rt_thread_t tid = rt_thread_create("timer_fire",
                                       check_timer_firing_status,
                                       RT_NULL,
                                       1024,
                                       10,
                                       10);

    if (tid) {
        rt_thread_startup(tid);
        return 0;
    }

    return -1;
}
INIT_APP_EXPORT(timer_firing_check_init);