/*
 * Timer中断实时监控 - 检查GIC pending状态
 *
 * 目的：验证Timer中断是否真的到达GIC，但未触发IRQ异常
 */

#include <rtthread.h>
#include <rthw.h>
#include "lynxi.h"

void monitor_timer_gic_pending(void)
{
    rt_kprintf("\n========================================\n");
    rt_kprintf("Timer GIC Pending State Monitor\n");
    rt_kprintf("========================================\n");

    /* Timer30在GICR的寄存器 (SGI_base = GICR_BASE + 0x10000) */
    volatile rt_uint32_t *gicr_ctlr      = (volatile rt_uint32_t *)(0x08100000 + 0x000);  /* GICR_CTLR */
    volatile rt_uint32_t *gicr_waker     = (volatile rt_uint32_t *)(0x08100000 + 0x014);  /* GICR_WAKER */
    volatile rt_uint32_t *gicr_ispendr0  = (volatile rt_uint32_t *)(0x08110000 + 0x200);  /* GICR_ISPENDR0 */
    volatile rt_uint32_t *gicr_isactiver0 = (volatile rt_uint32_t *)(0x08110000 + 0x300);  /* GICR_ISACTIVER0 */
    volatile rt_uint32_t *gicr_isenabler0 = (volatile rt_uint32_t *)(0x08110000 + 0x100);  /* GICR_ISENABLER0 */
    volatile rt_uint32_t *gicr_igroupr0  = (volatile rt_uint32_t *)(0x08110000 + 0x80);   /* GICR_IGROUPR0 */
    volatile rt_uint32_t *gicr_igrpmodr0 = (volatile rt_uint32_t *)(0x08110000 + 0xD00);  /* GICR_IGRPMODR0 */

    /* Timer硬件状态 */
    rt_uint64_t cntp_ctl = 0, cntp_tval = 0, cntp_cval = 0, cntpct = 0;

    /* ICC系统寄存器 */
    rt_uint64_t iar1 = 0;

    /* 监控10秒，使用busy wait避免依赖tick */
    for (int i = 0; i < 10; i++) {
        /* Busy wait ~1秒（不依赖tick） */
        for (volatile int delay = 0; delay < 10000000; delay++) { asm volatile("nop"); }

        /* 读取Timer硬件状态 */
        asm volatile("mrs %0, CNTP_CTL_EL0" : "=r"(cntp_ctl));
        asm volatile("mrs %0, CNTP_TVAL_EL0" : "=r"(cntp_tval));
        asm volatile("mrs %0, CNTP_CVAL_EL0" : "=r"(cntp_cval));
        asm volatile("mrs %0, CNTPCT_EL0" : "=r"(cntpct));

        /* 读取GIC Redistributor状态 */
        rt_uint32_t gicr_ctlr_val   = *gicr_ctlr;
        rt_uint32_t gicr_waker_val  = *gicr_waker;
        rt_uint32_t pending         = *gicr_ispendr0;
        rt_uint32_t active          = *gicr_isactiver0;
        rt_uint32_t enabled         = *gicr_isenabler0;
        rt_uint32_t groupr0         = *gicr_igroupr0;
        rt_uint32_t grpmodr0        = *gicr_igrpmodr0;

        /* 读取ICC_IAR1_EL1（Interrupt Acknowledge Register） */
        asm volatile("mrs %0, S3_0_C12_C12_0" : "=r"(iar1));

        /* 读取ICC_IGRPEN1_EL1（GIC Enable register） */
        rt_uint64_t icc_igrpen1 = 0;
        asm volatile("mrs %0, S3_0_C12_C12_7" : "=r"(icc_igrpen1));

        /* 读取ICC_PMR_EL1（Priority Mask register） */
        rt_uint64_t icc_pmr = 0;
        asm volatile("mrs %0, S3_0_C4_C6_0" : "=r"(icc_pmr));

        /* 读取DAIF（中断屏蔽寄存器） */
        rt_uint64_t daif = 0;
        asm volatile("mrs %0, DAIF" : "=r"(daif));

        /* 读取CurrentEL（当前异常级别） */
        rt_uint64_t current_el = 0;
        asm volatile("mrs %0, CurrentEL" : "=r"(current_el));

        /* 尝试读取HCR_EL2（只读EL1时会导致异常，所以先检查CurrentEL） */
        rt_uint64_t hcr_el2 = 0;
        rt_uint64_t current_el_level = (current_el >> 2) & 3;
        if (current_el_level == 2) {
            asm volatile("mrs %0, HCR_EL2" : "=r"(hcr_el2));
        } else if (current_el_level == 1) {
            hcr_el2 = 0xDEADBEEF;  /* 标记：无法在EL1读取HCR_EL2 */
        }

        rt_kprintf("\n[Second %d]\n", i+1);
        rt_kprintf("Timer HW: CTL=0x%llx, TVAL=%lld (%lld ms to expire)\n",
                   cntp_ctl, cntp_tval, (cntp_tval * 1000) / 32000000);
        rt_kprintf("  CVAL=%llx, CNTPCT=%llx (diff=%lld)\n",
                   cntp_cval, cntpct, cntp_cval - cntpct);
        rt_kprintf("  Timer ENABLE=%d, IMASK=%d, ISTATUS=%d\n",
                   (cntp_ctl >> 0) & 1, (cntp_ctl >> 1) & 1, (cntp_ctl >> 2) & 1);

        rt_kprintf("\n[异常级别和路由]\n");
        rt_kprintf("  CurrentEL:      0x%llx (EL=%d) ← 当前在哪个异常级别?\n",
                   current_el, current_el_level);
        if (current_el_level == 2) {
            rt_kprintf("  HCR_EL2:        0x%llx (IMO=%d, FMO=%d, AMO=%d) ← IRQ路由到哪个EL?\n",
                       hcr_el2, (hcr_el2 >> 3) & 1, (hcr_el2 >> 4) & 1, (hcr_el2 >> 5) & 1);
        } else if (current_el_level == 1) {
            rt_kprintf("  HCR_EL2:        无法读取（当前在EL1，IRQ已路由到EL1）\n");
        } else {
            rt_kprintf("  HCR_EL2:        0x%llx (标记值)\n", hcr_el2);
        }

        rt_kprintf("\n[ICC System Registers]\n");
        rt_kprintf("  ICC_IGRPEN1_EL1: 0x%llx (Enable=%d) ← GIC是否启用?\n",
                   icc_igrpen1, icc_igrpen1 & 1);
        rt_kprintf("  ICC_PMR_EL1:    0x%llx (Priority Mask) ← 允许优先级<=0x%llx的中断\n",
                   icc_pmr, icc_pmr);
        rt_kprintf("  ICC_IAR1_EL1:    0x%llx (IRQ ID=%lld) ← CPU ack了哪个中断?\n",
                   iar1, iar1 & 0x3FF);
        rt_kprintf("  DAIF:            0x%llx (IRQ mask=%d, FIQ mask=%d) ← 中断是否被屏蔽?\n",
                   daif, (daif >> 7) & 1, (daif >> 6) & 1);

        rt_kprintf("GICR_WAKER:  0x%08x (ProcessorSleep=%d, ChildrenAsleep=%d) ← CPU接口唤醒!\n",
                   *gicr_waker, (*gicr_waker >> 1) & 1, (*gicr_waker >> 2) & 1);
        rt_kprintf("GICR_CTLR:   0x%08x (IR=%d, EnableLPIs=%d)\n",
                   *gicr_ctlr, (*gicr_ctlr >> 0) & 1, (*gicr_ctlr >> 3) & 1);

        rt_kprintf("GICR_IGROUPR0:  0x%08x (Timer30 Group1=%d)\n",
                   *gicr_igroupr0, (*gicr_igroupr0 >> 30) & 1);
        rt_kprintf("GICR_IGRPMODR0: 0x%08x (Timer30 NS=%d)\n",
                   *gicr_igrpmodr0, (*gicr_igrpmodr0 >> 30) & 1);

        rt_kprintf("GICR_ISENABLER0: 0x%08x (Timer30 enabled=%d)\n",
                   enabled, (enabled >> 30) & 1);
        rt_kprintf("GICR_ISPENDR0:   0x%08x (Timer30 pending=%d) ← KEY!\n",
                   pending, (pending >> 30) & 1);
        rt_kprintf("GICR_ISACTIVER0: 0x%08x (Timer30 active=%d)\n",
                   active, (active >> 30) & 1);

        rt_kprintf("ICC_IAR1_EL1: 0x%llx (IRQ ID=%lld) ← Did CPU ack?\n",
                   iar1, iar1 & 0x3FF);

        /* 关键判断 */
        if ((pending >> 30) & 1) {
            rt_kprintf("★★★ Timer30 is PENDING in GIC! ★★★\n");
            rt_kprintf("Interrupt reached GIC but CPU didn't ack!\n");

            if (iar1 == 0 || (iar1 & 0x3FF) == 1023) {
                rt_kprintf("Problem: CPU read ICC_IAR1_EL1 = 0 or spurious!\n");
                rt_kprintf("Possible causes:\n");
                rt_kprintf("  - IRQ exception routed to EL3\n");
                rt_kprintf("  - GIC CPU interface not properly enabled\n");
                rt_kprintf("  - Interrupt priority issue\n");
            } else if ((iar1 & 0x3FF) == 30) {
                rt_kprintf("★★★ SUCCESS! CPU acked Timer30! ★★★\n");
                rt_kprintf("IRQ exception is working!\n");

                /* 手动EOI */
                asm volatile("msr S3_0_C12_C12_1, %0" :: "r"(iar1));
                rt_kprintf("Manual EOI sent for IRQ 30\n");
            }
        }

        if ((cntp_ctl >> 2) & 1) {
            rt_kprintf("★★★ Timer ISTATUS=1, timer is FIRING! ★★★\n");
        }

        if (cntp_tval <= 0) {
            rt_kprintf("★★★ TVAL <= 0, timer expired! Pending should be 1! ★★★\n");
            if ((pending >> 30) & 1) {
                rt_kprintf("✅ Timer30 pending=1 after expire - CORRECT!\n");
            } else {
                rt_kprintf("❌ Timer30 pending=0 after expire - INTERRUPT NOT REACHING GIC!\n");
            }
        }
    }

    rt_kprintf("\n========================================\n");
    rt_kprintf("Monitor Complete\n");
    rt_kprintf("========================================\n");
}

int timer_monitor_init(void)
{
    rt_thread_t tid = rt_thread_create("timer_mon",
                                       (void (*)(void *))monitor_timer_gic_pending,
                                       RT_NULL,
                                       4096,  /* 增大栈空间：1024→4096，避免栈溢出 */
                                       10,
                                       10);

    if (tid) {
        rt_thread_startup(tid);
        return 0;
    }

    return -1;
}
INIT_APP_EXPORT(timer_monitor_init);